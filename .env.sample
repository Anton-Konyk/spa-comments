# ========== Django ==========
SECRET_KEY="your-django-insecure-secret"
DEBUG="False"  # "True" - development, "False"  production mode

# A coma-separated list of hosts/domains where the backend is available (no schema)
# Example: 127.0.0.1,localhost,api.example.com
ALLOWED_HOSTS=127.0.0.1,localhost,your-backend-domain.com

# Full frontend origins (with scheme and port) from which requests are allowed
# Examples for local dev: http://127.0.0.1:5173,http://localhost:5173
# Example for Docker dev: http://127.0.0.1:8080,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Example: https://frontend.example.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173

# Dev (Docker): http://localhost:8000
# Production: https://api.example.com
FRONTEND_BACKEND_URL=http://localhost:8000

# Pagination
PAGE_SIZE=25

# ========== reCAPTCHA ==========
# Google kyes reCAPTCHA
RECAPTCHA_SITE_KEY="your_recaptcha_site_key"
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key"
RECAPTCHA_VERIFY_URL="https://www.google.com/recaptcha/api/siteverify"

# ========== Channels / Redis ==========
# If DEBUG="True" and you want InMemoryChannelLayer, leave it blank: REDIS_URL=""
# For Docker/Prod with Redis:
REDIS_URL=redis://redis:6379/0

# ========== DB ==========
# Choose DB: "sqlite" или "mysql"
DB_ENGINE=mysql

# --- MySQL (Docker/Prod) ---
DB_NAME=your_db_name
DB_USER=your_db_user_name
DB_PASSWORD=your_db_password
DB_HOST=db          # имя сервиса в docker-compose или хост СУБД
DB_PORT=3306
DB_CONN_MAX_AGE=60  # seconds, держим пул соединений

# --- SQLite (Dev) ---
SQLITE_PATH=/app/db.sqlite3

# ========== Swagger (optional) ==========
# Example: https://api.example.com  или http://localhost:8000
PUBLIC_API_BASE=http://localhost:8000

# ========== Docker-only: autocreation superuser ==========
DJANGO_SUPERUSER_USERNAME="admin"
DJANGO_SUPERUSER_EMAIL="admin@example.com"
DJANGO_SUPERUSER_PASSWORD="adminpass"

# ========== Security (dev) ==========
# When working behind a reverse proxy/Ingress:
# USE_X_FORWARDED_HOST=True
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# SECURE_SSL_REDIRECT="True"
